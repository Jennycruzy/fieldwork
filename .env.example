# Copy to .env and fill in. Never commit .env.

# Zetaris (local install, "run locally" route)
ZETARIS_URL=http://127.0.0.1:3000
ZETARIS_EMAIL=admin@zetaris.com
ZETARIS_PASSWORD=change-me

# Fieldwork's own Postgres (runs, traces, tract crosswalk)
FW_PG_URL=postgres://fieldwork:change-me@127.0.0.1:55433/fieldwork

# Model providers. Meterless Runtime is the primary provider; the others are used when it is offline.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Desk + API (loopback; nginx in front). 8790 is used by another service on the shared VPS.
FW_PORT=8795

# Source-table lineage is off until its added work is measured.
FW_ANSWER_LINEAGE=0

# Bounded Writer reasoning stays off until a full comparison measures its effect.
FW_MARKOVIAN_WRITER=0

# Additional question and source-metadata inspection; pending full measurement.
FW_SCOUT_GUARD=0

# Unmeasured keyword-versus-embedding comparison is deferred.
FW_FINDER_EMBEDDINGS=0
