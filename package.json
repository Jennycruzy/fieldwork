{
  "name": "fieldwork",
  "private": true,
  "version": "0.1.0",
  "description": "Ask a question about a Montgomery neighborhood; agents find the public data, join it in Zetaris, and show the record behind every number.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "ask": "tsx apps/api/src/cli.ts ask",
    "runtime": "tsx apps/api/src/cli.ts runtime",
    "wordscan": "node scripts/wordscan.mjs",
    "conformance:hmem": "HMEM_IMPL=$PWD/packages/hmem/src/index.ts tsx packages/hmem/conformance/runner.ts",
    "build": "vite build apps/web",
    "dev:web": "vite apps/web",
    "start": "tsx apps/api/src/serve.ts",
    "sample": "vite build apps/web && FW_SAMPLE=1 tsx apps/api/src/serve.ts",
    "conformance:world": "WORLD_MODEL_IMPL=$PWD/packages/world/src/index.ts tsx packages/world/conformance/runner.ts",
    "questions": "tsx scripts/question-set.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@fastify/static": "8.0.3",
    "@turf/boolean-point-in-polygon": "7.1.0",
    "@turf/helpers": "7.1.0",
    "fastify": "5.2.0",
    "leaflet": "1.9.4",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1",
    "zod": "3.24.1"
  }
}
