  "answer": {
    "sql": "WITH violations AS (\n  SELECT geoid, n AS code_violations\n  FROM fw_pg.tract_counts\n  WHERE run_id = 'r_20261024_72540e'\n    AND source = 'm1_city'\n    AND grp = 'all'\n),\ndiabetes AS (\n  SELECT tractfips AS geoid,\n         CAST(totalpopulation AS DOUBLE) AS totalpopulation,\n         CAST(diabetes_crudeprev AS DOUBLE) AS diabetes_share\n  FROM session.fw_72540e_m2_cdc\n)\nSELECT t.name,\n       v.code_violations,\n       d.diabetes_share,\n       d.totalpopulation\nFROM fw_pg.tracts t\nJOIN violations v ON v.geoid = t.geoid\nJOIN diabetes d ON d.geoid = t.geoid\nORDER BY v.code_violations DESC\nLIMIT 50",
