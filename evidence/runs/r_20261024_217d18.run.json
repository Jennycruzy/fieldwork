  "answer": {
    "sql": "WITH v AS (\n  SELECT geoid, CAST(n AS DOUBLE) AS code_violations\n  FROM fw_pg.tract_counts\n  WHERE run_id = 'r_20261024_217d18'\n    AND source = 'm1_city'\n    AND grp = 'all'\n),\nh AS (\n  SELECT\n    tractfips AS geoid,\n    CAST(totalpopulation AS DOUBLE) AS population,\n    CAST(bphigh_crudeprev AS DOUBLE) AS high_bp_prev\n  FROM session.fw_217d18_m2_cdc\n),\nj AS (\n  SELECT\n    t.name,\n    v.code_violations,\n    h.population,\n    h.high_bp_prev,\n    CASE WHEN h.population > 0 THEN v.code_violations / h.population * 1000.0 ELSE NULL END AS violations_per_1000_adults\n  FROM fw_pg.tracts t\n  INNER JOIN v ON v.geoid = t.geoid\n  INNER JOIN h ON h.geoid = t.geoid\n),\ncorr AS (\n  SELECT\n    (COUNT(*) * SUM(violations_per_1000_adults * high_bp_prev) - SUM(violations_per_1000_adults) * SUM(high_bp_prev)) /\n    SQRT((COUNT(*) * SUM(violations_per_1000_adults * violations_per_1000_adults) - SUM(violations_per_1000_adults) * SUM(violations_per_1000_adults)) *\n         (COUNT(*) * SUM(high_bp_prev * high_bp_prev) - SUM(high_bp_prev) * SUM(high_bp_prev))) AS pearson_corr\n  FROM j\n  WHERE violations_per_1000_adults IS NOT NULL AND high_bp_prev IS NOT NULL\n)\nSELECT\n  j.name,\n  j.population,\n  j.code_violations,\n  j.violations_per_1000_adults,\n  j.high_bp_prev,\n  c.pearson_corr\nFROM j\nCROSS JOIN corr c\nORDER BY j.violations_per_1000_adults DESC, j.high_bp_prev DESC\nLIMIT 50",
