    "sql": "WITH per_tract AS (\n  SELECT\n    t.name AS tract_name,\n    tc.n AS code_violations_2026,\n    CAST(cdc.bphigh_crudeprev AS DOUBLE) * CAST(cdc.totalpopulation AS DOUBLE) / 100 AS estimated_adults_with_high_blood_pressure\n  FROM fw_pg.tracts AS t\n  LEFT JOIN fw_pg.tract_counts AS tc\n    ON tc.geoid = t.geoid\n   AND tc.run_id = 'r_20261024_e05c17'\n   AND tc.source = 'm1_city'\n   AND tc.grp = 'all'\n  LEFT JOIN session.fw_e05c17_m2_cdc AS cdc\n    ON cdc.tractfips = t.geoid\n)\nSELECT\n  tract_name,\n  code_violations_2026,\n  estimated_adults_with_high_blood_pressure,\n  CORR(code_violations_2026, estimated_adults_with_high_blood_pressure) OVER () AS correlation_coefficient\nFROM per_tract",
