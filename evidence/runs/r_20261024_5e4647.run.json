  "mode": "live",
  "answer": {
    "sql": "WITH code_counts AS (\n  SELECT geoid, CAST(n AS DOUBLE) AS violations\n  FROM fw_pg.tract_counts\n  WHERE run_id = 'r_20261024_5e4647' AND source = 'm1_city' AND grp = 'all'\n),\ncdc AS (\n  SELECT tractfips AS geoid,\n         CAST(totalpopulation AS DOUBLE) AS totalpopulation,\n         CAST(bphigh_crudeprev AS DOUBLE) AS high_blood_pressure_prevalence\n  FROM session.fw_5e4647_m2_cdc\n),\nbase AS (\n  SELECT t.name,\n         t.geoid,\n         CASE WHEN cc.violations IS NOT NULL AND c.totalpopulation IS NOT NULL AND c.totalpopulation > 0\n              THEN cc.violations / c.totalpopulation * 1000 END AS code_violations_per_1000_residents,\n         c.high_blood_pressure_prevalence\n  FROM fw_pg.tracts t\n  LEFT JOIN code_counts cc ON cc.geoid = t.geoid\n  LEFT JOIN cdc c ON c.geoid = t.geoid\n),\npaired AS (\n  SELECT *\n  FROM base\n  WHERE code_violations_per_1000_residents IS NOT NULL AND high_blood_pressure_prevalence IS NOT NULL\n)\nSELECT name,\n       code_violations_per_1000_residents,\n       high_blood_pressure_prevalence,\n       CORR(code_violations_per_1000_residents, high_blood_pressure_prevalence) OVER () AS corr_code_violations_high_blood_pressure,\n       COUNT(*) OVER () AS paired_tracts,\n       geoid\nFROM paired\nORDER BY code_violations_per_1000_residents DESC, name ASC\nLIMIT 200",
    "plan": {
